FROM node:22-alpine

WORKDIR /managing-system

COPY package*.json ./
RUN apk add --no-cache docker-cli python3 make g++ \
  && npm ci

COPY tsconfig.json tsconfig.build.json tsconfig.scripts.json ./
COPY prisma.config.ts ./
COPY prisma ./prisma
COPY src ./src
COPY scripts ./scripts

ARG SOURCE_REVISION=unrecorded
RUN node -e 'const fs = require("node:fs"); const revision = process.argv[1]; if (revision !== "unrecorded" && !/^[a-f0-9]{40}$/.test(revision)) throw new Error("Invalid build revision"); fs.writeFileSync("build-identity.json", JSON.stringify({sourceRevision: revision}));' "$SOURCE_REVISION"
RUN npm run build

CMD ["npm", "run", "start:container"]
