FROM node:22-alpine

WORKDIR /managing-system

COPY managing-system/package*.json ./
RUN apk add --no-cache docker-cli python3 make g++ \
  && npm ci

COPY managing-system/tsconfig.json managing-system/tsconfig.build.json managing-system/tsconfig.scripts.json ./
COPY managing-system/prisma.config.ts ./
COPY managing-system/prisma ./prisma
COPY managing-system/src ./src
COPY managing-system/scripts ./scripts

WORKDIR /dashboard
COPY dashboard/package*.json ./
RUN npm ci
COPY dashboard ./
RUN npm run build

WORKDIR /managing-system

ARG SOURCE_REVISION=unrecorded
RUN node -e 'const fs = require("node:fs"); const revision = process.argv[1]; if (revision !== "unrecorded" && !/^[a-f0-9]{40}$/.test(revision)) throw new Error("Invalid build revision"); fs.writeFileSync("build-identity.json", JSON.stringify({sourceRevision: revision}));' "$SOURCE_REVISION"
RUN npm run build

CMD ["npm", "run", "start:container"]
