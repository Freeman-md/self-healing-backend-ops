{
  "name": "managing-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "dev": "tsx watch src/index.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --tsconfig tsconfig.test.json --test tests/unit/**/*.test.ts",
    "test:integration": "tsx --tsconfig tsconfig.test.json --test tests/integration/**/*.test.ts",
    "test:types": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^6.45.0",
    "zod": "^4.4.3"
  }
}
