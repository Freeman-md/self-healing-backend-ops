{
  "name": "managing-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "dev": "tsx watch src/index.ts",
    "test": "npm run prisma:generate && npm run test:unit && npm run test:integration",
    "test:unit": "tsx --tsconfig tsconfig.test.json --test-concurrency=1 --test tests/unit/**/*.test.ts",
    "test:integration": "tsx --tsconfig tsconfig.test.json --test-concurrency=1 --test tests/integration/**/*.test.ts",
    "test:types": "npm run prisma:generate && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "start:container": "npm run prisma:migrate:deploy && npm run prisma:seed && npm run start",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "prisma:verify-seed": "tsx prisma/verify-seed.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/node": "^24.13.2",
    "prisma": "^7.9.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "pg": "^8.16.3",
    "dotenv": "^17.4.2",
    "openai": "^6.45.0",
    "zod": "^4.4.3"
  }
}
