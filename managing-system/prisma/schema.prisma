generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum RiskLevel {
  low
  medium
  high
}

enum SafetyCheckType {
  evidence_state_matches
  max_attempts_not_exceeded
}

enum SafetyFailureAction {
  block
  escalate
}

enum OutcomeCheckType {
  health_status_is
  endpoint_returns_status
  metric_below_threshold
  container_running
  file_exists
  action_completed
}

enum ActionExecutionStatus {
  skipped
  blocked
  executed
  failed
}

enum ActionExecutionContinuation {
  resolved
  continue
  blocked
  escalated
  failed
}

enum SafetyCheckStatus {
  passed
  failed
  not_checked
}

enum RawEvidenceSource {
  health
  metrics
  logs
  business_endpoint @map("business-endpoint")
  container
}

enum CollectionStatus {
  collected
  failed
}

enum EvidenceState {
  healthy
  degraded
  unhealthy
  unknown
}

enum EvidenceSignalCode {
  managed_system_reachability
  managed_system_health
  managed_system_container_state
  database_connectivity
  postgres_container_state
  metrics_availability
  configuration_validity
  unknown
}

enum EvidenceSignalStatus {
  normal
  warning
  critical
  unknown
}

enum EvidenceDerivationMethod {
  deterministic
  llm
}

enum IncidentCode {
  managed_system_unreachable
  managed_system_service_down
  database_connectivity_failure
  postgres_unavailable
  bad_runtime_configuration
  unclassified
  no_incident
  unclassified_incident
}

enum DiagnosisMethod {
  deterministic
  llm
}

enum IncidentSeverity {
  low
  medium
  high
  critical
}

enum RecoveryMode {
  baseline
  agent
}

enum RecoveryDecisionStatus {
  no_action
  action_selected
  escalate
}

enum ActionPhase {
  proposed
  fallback
}

enum BaselineGroupMatchMode {
  ALL
  ANY
}

enum BaselineOperator {
  EQUALS
}

enum TrialStatus {
  started
  resolved
  unresolved
  escalated
  failed
}

enum TrialOutcome {
  resolved_safely
  unresolved_escalated
  unresolved_not_escalated
  resolved_unsafely
  failed
}

enum TrialEvidenceRole {
  initial
  intermediate
  final
}

enum ActionEffectiveness {
  effective
  partially_effective
  ineffective
  unknown
}
